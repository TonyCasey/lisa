# Lisa Configuration
# Storage mode: local (MCP), neo4j (direct queries), zep-cloud
STORAGE_MODE=local

# Logging: debug, info, warn, error, silent
LOG_LEVEL=debug
LOG_CONSOLE=true # write to file AND stderr

# Graphiti MCP endpoint (for local mode)
GRAPHITI_ENDPOINT={{GRAPHITI_ENDPOINT}}

# Neo4j connection (for neo4j mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demodemo
NEO4J_DATABASE=neo4j

# LLM Feature Toggles (comma-separated, or * for all)
# Features: summarization, extraction, deduplication, curation, test
# LISA_LLM_FEATURES=*

# LLM Monthly Budget Limit (in USD, e.g., 10.00)
# LISA_LLM_MONTHLY_LIMIT=

# llm api keys
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
